+def test_gemma4_preserves_bf16_and_gated_expert_slot_order(tmp_path):
+    ckpt_dir = tmp_path / "ckpt"
+    ckpt_dir.mkdir()
+    config = {
+        "architectures": ["Gemma4ForConditionalGeneration"],
+        "model_type": "gemma4",
+        "dtype": "bfloat16",
+        "text_config": {
+            "model_type": "gemma4_text",
+            "enable_moe_block": True,
+            "hidden_size": HIDDEN,
+            "intermediate_size": 2 * FFN,
+            "moe_intermediate_size": FFN,
+            "num_hidden_layers": 2,
+            "num_experts": NUM_EXPERTS,
+            "top_k_experts": 2,
+            "num_attention_heads": 4,
+            "num_key_value_heads": 2,
+            "head_dim": 8,
+            "global_head_dim": 8,
+            "num_global_key_value_heads": 2,
+            "layer_types": ["sliding_attention", "full_attention"],
+            "vocab_size": 64,
+            "dtype": "bfloat16",
+        },
+    }
+    (ckpt_dir / "config.json").write_text(json.dumps(config))
+    torch.manual_seed(59)
+    state = {
+        "model.vision_tower.patch_embedder.weight": torch.randn(
+            HIDDEN, 4, dtype=torch.bfloat16
+        )
+    }
+    for layer in range(2):
+        prefix = f"model.language_model.layers.{layer}"
+        state[f"{prefix}.experts.gate_up_proj"] = torch.randn(
+            NUM_EXPERTS, 2 * FFN, HIDDEN, dtype=torch.bfloat16
+        )
+        state[f"{prefix}.experts.down_proj"] = torch.randn(
+            NUM_EXPERTS, HIDDEN, FFN, dtype=torch.bfloat16
+        )
+        state[f"{prefix}.router.per_expert_scale"] = torch.randn(
+            NUM_EXPERTS, dtype=torch.bfloat16
+        )
+        state[f"{prefix}.mlp.gate_proj.weight"] = torch.randn(
+            2 * FFN, HIDDEN, dtype=torch.bfloat16
+        )
+    save_file(state, str(ckpt_dir / "model.safetensors"))
+    store_dir = tmp_path / "store"
+    convert_checkpoint(str(ckpt_dir), str(store_dir))
+    index = read_index(store_dir)
+    assert len([group for group in index.groups if group.is_expert]) == 8
+    for layer in range(2):
+        for expert in range(NUM_EXPERTS):
+            prefix = f"model.language_model.layers.{layer}.experts"
+            gate, up = state[f"{prefix}.gate_up_proj"][expert].chunk(2)
+            expected = (gate, up, state[f"{prefix}.down_proj"][expert])
+            group = index.expert_group(layer, expert)
+            assert [member.name.split(".")[-2] for member in group.members] == [
+                "gate_proj",
+                "up_proj",
+                "down_proj",
+            ]
+            for member, tensor in zip(group.members, expected):
+                loaded = read_member_tensor(store_dir, group, member)
+                assert loaded.dtype == torch.bfloat16
+                assert torch.equal(loaded, tensor.contiguous())
+    dense = {
+        member.name
+        for group in index.groups
+        if not group.is_expert
+        for member in group.members
+    }
+    assert dense == {name for name in state if ".experts." not in name}

