new file mode 100644
index 0000000..8e0e2ee
--- /dev/null
+++ b/moe_store/wrappers/gemma4.py
@@ -0,0 +1,91 @@
+# Copyright (c) EfficientMoE.
+# SPDX-License-Identifier: Apache-2.0
+
+from typing import Optional
+
+import torch
+import torch.nn as nn
+from transformers.activations import ACT2FN
+
+
+class _Gemma4ExpertMLP(nn.Module):
+    def __init__(self, config):
+        super().__init__()
+        hidden = config.hidden_size
+        intermediate = config.moe_intermediate_size
+        self.gate_proj = nn.Linear(hidden, intermediate, bias=False)
+        self.up_proj = nn.Linear(hidden, intermediate, bias=False)
+        self.down_proj = nn.Linear(intermediate, hidden, bias=False)
+        self.act_fn = ACT2FN[config.hidden_activation]
+
+    def forward(self, hidden_states):
+        return self.down_proj(
+            self.act_fn(self.gate_proj(hidden_states))
+            * self.up_proj(hidden_states)
+        )
+
+
+class SyncGemma4TextExperts(nn.ModuleList):
+    archer_config = None
+    layer_id: Optional[int] = None
+
+    def __init__(self, config):
+        super().__init__(
+            [_Gemma4ExpertMLP(config) for _ in range(config.num_experts)]
+        )
+        self.num_experts = config.num_experts
+        self.top_k = config.top_k_experts
+        self.expert_executor = None
+        self.expert_prefetcher = None
+        self.expert_tracer = None
+        self.expert_predictor = None
+        self.archer_engine = None
+        self.lib = None
+
+    @property
+    def experts(self):
+        return self
+
+    def forward(self, hidden_states, top_k_index, top_k_weights):
+        if self.expert_executor is None:
+            result = torch.zeros_like(hidden_states)
+            for expert_idx, expert in enumerate(self):
+                token_idx, top_k_pos = torch.where(top_k_index == expert_idx)
+                if token_idx.numel() == 0:
+                    continue
+                expert_out = expert(hidden_states[token_idx])
+                weighted = (
+                    expert_out * top_k_weights[token_idx, top_k_pos, None]
+                )
+                result.index_add_(0, token_idx, weighted.to(result.dtype))
+            return result
+
+        return self._dispatch(hidden_states, top_k_index, top_k_weights)
+
+    @torch.inference_mode(False)
+    @torch.no_grad()
+    def _dispatch(self, hidden_states, top_k_index, top_k_weights):
+        # Native workers update shared buffers outside the caller's thread state.
+        # HF reserves expert ID E as a sentinel; it contributes no route.
+        valid = top_k_index != self.num_experts
+        safe_index = top_k_index.masked_fill(~valid, 0)
+        shape = (hidden_states.shape[0], self.num_experts)
+        route_counts = torch.zeros(
+            shape, dtype=torch.long, device=hidden_states.device
+        )
+        route_counts.scatter_add_(1, safe_index, valid.long())
+        routing_weights = torch.zeros(
+            shape, dtype=top_k_weights.dtype, device=hidden_states.device
+        )
+        routing_weights.scatter_add_(
+            1, safe_index, top_k_weights.masked_fill(~valid, 0)
+        )
+        self.expert_executor.dispatch_local(
+            self.layer_id,
+            hidden_states,
+            route_counts > 0,
+            routing_weights,
+        )
+        return self.expert_executor.wait_dispatch_local().to(
+            hidden_states.dtype
+        )
diff --git a/tests/test_gemma4_registry.py b/tests/test_gemma4_registry.py
new file mode 100644
index 0000000..b98c640
--- /dev/null
+++ b/tests/test_gemma4_registry.py
@@ -0,0 +1,134 @@
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+import pytest
+import torch
+from transformers import PretrainedConfig
+
+from moe_store.convert.planner import TensorSpec
+from moe_store.convert.v5_remap import V5Expansion
+from moe_store.parsing.hf_config import parse_expert_id, parse_moe_param
+from moe_store.registry import constants
+from moe_store.registry.slots import member_slot_rank
+from moe_store.wrappers import SyncGemma4TextExperts
+
+
+@pytest.fixture
+def gemma4_config():
+    return PretrainedConfig.from_dict(
+        {
+            "architectures": ["Gemma4ForConditionalGeneration"],
+            "model_type": "gemma4",
+            "text_config": {
+                "enable_moe_block": True,
+                "num_hidden_layers": 2,
+                "num_experts": 4,
+                "hidden_size": 32,
+                "moe_intermediate_size": 16,
+            },
+        }
+    )
+
+
+def test_gemma4_registration_is_guarded(gemma4_config):
+    model_class = constants.Gemma4ForConditionalGeneration
+    assert ("gemma4" in constants.MODEL_MAPPING_NAMES) is (
+        model_class is not None
+    )
+    if model_class is not None:
+        assert constants.MODEL_MAPPING_NAMES["gemma4"] is model_class
+        assert constants.parse_expert_type(gemma4_config) == 5
+
+
+def test_gemma4_parses_nested_moe_config(gemma4_config):
+    assert parse_moe_param(gemma4_config) == (2, 4, 0)
+
+
+def test_gemma4_rejects_dense_configuration(gemma4_config):
+    gemma4_config.text_config["enable_moe_block"] = False
+    with pytest.raises(RuntimeError, match="enable_moe_block"):
+        parse_moe_param(gemma4_config)
+
+
+@pytest.mark.parametrize(
+    "name, expected",
+    [
+        ("model.language_model.layers.1.experts.3.gate_proj.weight", (1, 3)),
+        ("model.language_model.layers.0.experts.2.down_proj.weight", (0, 2)),
+        (
+            "model.language_model.layers.2.experts.0.up_proj.weight",
+            (None, None),
+        ),
+        (
+            "model.language_model.layers.0.experts.4.up_proj.weight",
+            (None, None),
+        ),
+        ("model.language_model.layers.0.router.proj.weight", (None, None)),
+        ("model.language_model.layers.0.router.per_expert_scale", (None, None)),
+        ("model.language_model.layers.0.mlp.gate_proj.weight", (None, None)),
+        (
+            "model.vision_tower.layers.0.experts.0.gate_proj.weight",
+            (None, None),
+        ),
+    ],
+)
+def test_gemma4_expert_ids(gemma4_config, name, expected):
+    assert parse_expert_id(name, gemma4_config) == expected
+
+
+def test_gemma4_member_slot_order():
+    prefix = "model.language_model.layers.0.experts.0"
+    assert [
+        member_slot_rank(
+            "Gemma4ForConditionalGeneration", f"{prefix}.{slot}.weight"
+        )
+        for slot in ("gate_proj", "up_proj", "down_proj")
+    ] == [0, 1, 2]
+
+
+def test_gemma4_dispatch_preserves_router_weights_and_bf16_output():
+    config = SimpleNamespace(
+        hidden_size=32,
+        moe_intermediate_size=16,
+        num_experts=4,
+        top_k_experts=2,
+        hidden_activation="gelu_pytorch_tanh",
+    )
+    module = SyncGemma4TextExperts(config).bfloat16()
+    module.layer_id = 1
+    module.expert_executor = MagicMock()
+    native_output = torch.randn(2, 32, dtype=torch.float32)
+    module.expert_executor.wait_dispatch_local.return_value = native_output
+    hidden = torch.randn(2, 32, dtype=torch.bfloat16)
+    indices = torch.tensor([[0, 1], [2, 4]])
+    weights = torch.tensor([[0.25, 1.75], [2.0, 0.5]], dtype=torch.float32)
+    with torch.inference_mode():
+        actual = module(hidden, indices, weights)
+    torch.testing.assert_close(actual, native_output.bfloat16(), rtol=0, atol=0)
+    assert actual.dtype == torch.bfloat16
+    layer, passed_hidden, mask, routed = (
+        module.expert_executor.dispatch_local.call_args.args
+    )
+    assert layer == 1 and passed_hidden is hidden
+    assert routed.dtype == torch.float32
+    torch.testing.assert_close(
+        routed, torch.tensor([[0.25, 1.75, 0, 0], [0, 0, 2, 0]])
+    )
+    assert torch.equal(mask, routed != 0)
+
+
+@pytest.mark.parametrize(
+    "field, shape",
+    [
+        ("gate_up_proj", (4, 32, 32, 1)),
+        ("gate_up_proj", (3, 32, 32)),
+        ("gate_up_proj", (4, 16, 32)),
+        ("down_proj", (4, 16, 32)),
+    ],
+)
+def test_gemma4_rejects_wrong_packed_layout(gemma4_config, field, shape):
+    name = f"model.language_model.layers.0.experts.{field}"
+    spec = TensorSpec(name, 0, "bfloat16", shape)
+    expansion = V5Expansion(gemma4_config, lambda _: spec)
+    with pytest.raises(ValueError, match="Gemma4.*shape"):
+        expansion.expand_names([name])
